echo '### New Relic PHP agent (disabled by default); the generated newrelic.ini is kept as a reference outside conf.d' \
&& curl -fL https://download.newrelic.com/php_agent/archive/12.13.0.43/newrelic-php5-12.13.0.43-linux.tar.gz -o /tmp/newrelic.tar.gz \
&& echo 'dca19d0a845b78dc9fc5e412c215d6534b0232428ab6e0eec05d9d82091e4f21  /tmp/newrelic.tar.gz' | sha256sum -c - \
&& tar -C /tmp -zxf /tmp/newrelic.tar.gz \
&& NR_INSTALL_USE_CP_NOT_LN=1 NR_INSTALL_SILENT=1 /tmp/newrelic-php5-12.13.0.43-linux/newrelic-install install \
&& mkdir -p /usr/local/share/newrelic \
&& mv "$PHP_INI_DIR/conf.d/newrelic.ini" /usr/local/share/newrelic/newrelic.ini.example \
&& rm -rf /tmp/newrelic.tar.gz /tmp/newrelic-php5-* /tmp/nrinstall*
