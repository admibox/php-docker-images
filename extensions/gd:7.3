echo '### GD for PHP 7.3 (old configure syntax)' \
&& apt-get install --no-install-recommends -y libfreetype6-dev libpng-dev libjpeg62-turbo-dev libjpeg-dev libwebp-dev \
	&& FREETYPE2_DIR="$(pkg-config --variable=prefix freetype2)" docker-php-ext-configure gd --with-gd --with-freetype-dir=/usr/include/ --with-jpeg-dir=/usr/include/ --with-png-dir=/usr/include/ --with-webp-dir=/usr/include/ \
	&& docker-php-ext-install gd \
	&& apt-mark manual 'libfreetype6' 'libpng16*' 'libjpeg62*' 'libwebp[0-9]*' \
	&& apt-get --purge remove -y libfreetype6-dev libpng-dev libjpeg62-turbo-dev libjpeg-dev libwebp-dev
